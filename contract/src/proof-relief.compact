// ProofRelief: private aid eligibility with one claim per credential per campaign.
//
// Public ledger holds only campaign rules, issuer status, claim counts and
// consumed nullifiers. Beneficiary attributes never leave the prover.

pragma language_version >= 0.23;

import CompactStandardLibrary;

export struct Campaign {
  active: Boolean;
  requiredRegion: Bytes<32>;
  maxIncome: Uint<64>;
  minHouseholdSize: Uint<16>;
  claimCount: Uint<64>;
}

// Held only by the beneficiary. Enters circuits exclusively through the credential() witness.
export struct Credential {
  holderSecret: Bytes<32>;
  region: Bytes<32>;
  income: Uint<64>;
  householdSize: Uint<16>;
  nonce: Bytes<32>;
  issuerId: Bytes<32>;
}

// Commitment to the admin secret key. Admin circuits re-derive and compare it.
export ledger admin: Bytes<32>;

// Random per-deployment value that domain-separates nullifiers.
export ledger deploymentSalt: Bytes<32>;

export ledger campaigns: Map<Bytes<32>, Campaign>;
export ledger approvedIssuers: Map<Bytes<32>, Boolean>;
export ledger consumedNullifiers: Set<Bytes<32>>;

// Leaves are H(issuerId, credentialCommitment). Historic so a path proven against
// an older root stays valid after later issuance.
export ledger credentials: HistoricMerkleTree<16, Bytes<32>>;

witness adminSecretKey(): Bytes<32>;
witness issuerSecretKey(): Bytes<32>;
witness credential(): Credential;
witness credentialPath(leaf: Bytes<32>): MerkleTreePath<16, Bytes<32>>;

constructor(salt: Bytes<32>) {
  admin = disclose(adminPublicKey(adminSecretKey()));
  deploymentSalt = disclose(salt);
}

export circuit createCampaign(
  campaignId: Bytes<32>,
  requiredRegion: Bytes<32>,
  maxIncome: Uint<64>,
  minHouseholdSize: Uint<16>
): [] {
  assertAdmin();
  const id = disclose(campaignId);
  assert(!campaigns.member(id), "Campaign already exists");
  assert(disclose(minHouseholdSize) > 0, "Minimum household size must be positive");
  campaigns.insert(id, Campaign {
    active: true,
    requiredRegion: disclose(requiredRegion),
    maxIncome: disclose(maxIncome),
    minHouseholdSize: disclose(minHouseholdSize),
    claimCount: 0
  });
}

export circuit closeCampaign(campaignId: Bytes<32>): [] {
  assertAdmin();
  const id = disclose(campaignId);
  assert(campaigns.member(id), "Unknown campaign");
  campaigns.insert(id, Campaign { ...campaigns.lookup(id), active: false });
}

export circuit setIssuerStatus(issuerId: Bytes<32>, approved: Boolean): [] {
  assertAdmin();
  approvedIssuers.insert(disclose(issuerId), disclose(approved));
}

// The commitment hides every credential attribute; only the issuer identity is disclosed.
export circuit issueCredential(commitment: Bytes<32>): [] {
  const issuerId = disclose(issuerPublicKey(issuerSecretKey()));
  assert(issuerApproved(issuerId), "Issuer is not approved");
  credentials.insert(disclose(credentialLeaf(issuerId, commitment)));
}

// Proves: the hidden credential was issued by an approved issuer, belongs to the
// prover, and satisfies the campaign rules. Then consumes the campaign nullifier
// and increments the claim count together; any failed assertion does neither.
export circuit claim(campaignId: Bytes<32>): [] {
  const id = disclose(campaignId);
  assert(campaigns.member(id), "Unknown campaign");
  const campaign = campaigns.lookup(id);
  assert(campaign.active, "Campaign is not active");

  const cred = credential();
  assert(issuerApproved(disclose(cred.issuerId)), "Issuer is not approved");

  const commitment = credentialCommitment(
    cred.region,
    cred.income,
    cred.householdSize,
    cred.nonce,
    holderPublicKey(cred.holderSecret)
  );
  const leaf = credentialLeaf(cred.issuerId, commitment);
  const path = credentialPath(leaf);
  assert(disclose(path.leaf == leaf), "Credential path does not match credential");
  assert(credentials.checkRoot(disclose(merkleTreePathRoot<16, Bytes<32>>(path))), "Credential was not issued");

  assert(disclose(cred.region == campaign.requiredRegion), "Region requirement not met");
  assert(disclose(cred.income <= campaign.maxIncome), "Income above campaign limit");
  assert(disclose(cred.householdSize >= campaign.minHouseholdSize), "Household below campaign minimum");

  const nullifier = disclose(claimNullifier(deploymentSalt, id, holderBinding(cred.holderSecret, commitment)));
  assert(!consumedNullifiers.member(nullifier), "Credential already claimed for this campaign");

  consumedNullifiers.insert(nullifier);
  campaigns.insert(id, Campaign { ...campaign, claimCount: campaign.claimCount + 1 as Uint<64> });
}

circuit assertAdmin(): [] {
  assert(disclose(adminPublicKey(adminSecretKey()) == admin), "Caller is not the admin");
}

circuit issuerApproved(issuerId: Bytes<32>): Boolean {
  return approvedIssuers.member(issuerId) && approvedIssuers.lookup(issuerId);
}

export pure circuit adminPublicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "proof-relief:admin:v1"), sk]);
}

export pure circuit issuerPublicKey(sk: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "proof-relief:issuer:v1"), sk]);
}

// What the holder hands to the issuer. The issuer never learns holderSecret.
export pure circuit holderPublicKey(holderSecret: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<2, Bytes<32>>>([pad(32, "proof-relief:holder-pk:v1"), holderSecret]);
}

export pure circuit credentialCommitment(
  region: Bytes<32>,
  income: Uint<64>,
  householdSize: Uint<16>,
  nonce: Bytes<32>,
  holderPk: Bytes<32>
): Bytes<32> {
  return persistentHash<[Bytes<32>, Bytes<32>, Uint<64>, Uint<16>, Bytes<32>, Bytes<32>]>(
    [pad(32, "proof-relief:credential:v1"), region, income, householdSize, nonce, holderPk]
  );
}

export pure circuit credentialLeaf(issuerId: Bytes<32>, commitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "proof-relief:leaf:v1"), issuerId, commitment]);
}

export pure circuit holderBinding(holderSecret: Bytes<32>, commitment: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<3, Bytes<32>>>([pad(32, "proof-relief:holder:v1"), holderSecret, commitment]);
}

// Same credential + same campaign + same deployment always gives the same nullifier.
// No session, challenge or caller input is mixed in, so replays cannot vary it.
export pure circuit claimNullifier(salt: Bytes<32>, campaignId: Bytes<32>, binding: Bytes<32>): Bytes<32> {
  return persistentHash<Vector<4, Bytes<32>>>([pad(32, "proof-relief:claim:v1"), salt, campaignId, binding]);
}
