{
  "name": "proof-relief",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Private, one-claim-per-person aid eligibility proofs on Midnight",
  "license": "Apache-2.0",
  "packageManager": "bun@1.3.14",
  "engines": {
    "node": ">=22.15"
  },
  "workspaces": [
    "contract",
    "cli",
    "interface"
  ],
  "scripts": {
    "compact": "bun run --filter @proof-relief/contract compact",
    "build": "bun run --filter @proof-relief/contract build && bun run --filter @proof-relief/interface build",
    "test": "bun run --filter @proof-relief/contract test",
    "typecheck": "bun run --filter '*' typecheck",
    "proof-server": "docker compose -f proof-server.yml up"
  },
  "devDependencies": {
    "@types/node": "^24.13.4",
    "typescript": "6.0.3",
    "vitest": "4.1.11"
  }
}
