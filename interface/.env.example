# Copy to .env.local and fill in after `bun run relief deploy --network preprod`.
VITE_NETWORK_ID=preprod
VITE_CONTRACT_ADDRESS=
VITE_CAMPAIGN_ID=borno-flood-relief
VITE_CAMPAIGN_NAME=Borno Flood Relief

# Used to read public state before a wallet is connected.
VITE_INDEXER_URI=https://indexer.preprod.midnight.network/api/v3/graphql
VITE_INDEXER_WS_URI=wss://indexer.preprod.midnight.network/api/v3/graphql/ws
